// docs/plan.md §3 – full data model (WP2). Money is Decimal(12,2) in shop currency; every amount comes from *_price_set.shop_money.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShopStatus {
  ALLOWLISTED // pre-created in the dashboard, not installed yet
  PENDING // installed, not activated
  ACTIVE
  UNINSTALLED
}

enum UserRole {
  ADMIN
  MEMBER
  CLIENT
}

enum AuditAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  CODE_CHANGED_WHILE_RUNNING
}

enum ExperimentType {
  CODE
  REDIRECT
  PRICE
  SHIPPING
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  PAUSED
  ENDED
}

enum Metric {
  CR
  RPV
  AOV
}

enum Decision {
  WINNER
  NO_DIFFERENCE
  INVALID
  ABORTED
}

enum AttributionSource {
  CART_ATTRIBUTE
  LINE_ITEM_PROPERTY
  CUSTOMER_LOOKUP
}

enum ReconStatus {
  OK
  MISMATCH
}

model Shop {
  id             String              @id @default(cuid())
  domain         String              @unique // "kunde.myshopify.com"
  name           String
  accessToken    String? // offline token, AES-256-GCM via services/crypto.server.ts; null while ALLOWLISTED / UNINSTALLED
  session        String? // encrypted Shopify Session (toPropertyArray as JSON) incl. refresh token; read by ShopSessionStorage
  scope          String? // granted scopes, updated by app/scopes_update
  status         ShopStatus
  requireConsent Boolean             @default(false)
  timezone       String? // shop.ianaTimezone
  installedAt    DateTime?
  activatedAt    DateTime? // set on first ACTIVE; a reinstall after UNINSTALLED becomes ACTIVE again only if this is set
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  users          UserShop[]
  auditLog       AuditLog[]
  webhookEvents  WebhookEvent[]
  experiments    Experiment[]
  results        ExperimentResult[]
  exposures      Exposure[]
  orders         Order[]
  dailyStats     DailyStat[]
  reconciliation ReconciliationRun[]
  snippetErrors  SnippetError[]
}

model Experiment {
  id                String             @id @default(cuid())
  shopId            String
  shop              Shop               @relation(fields: [shopId], references: [id])
  key               String // slug, unique per shop – contract 4.1 `^[a-z0-9-]+$`
  name              String
  hypothesis        String?
  type              ExperimentType     @default(CODE)
  status            ExperimentStatus   @default(DRAFT)
  allocation        Float              @default(1.0)
  salt              String // random, fixed after creation (contract 4.4)
  targeting         Json // contract 4.2
  trigger           Json // { type: "immediate" } | { type: "visible", selector }
  hideUntilApplied  Boolean            @default(false)
  primaryMetric     Metric             @default(CR)
  plannedSampleSize Int? // per variant
  startedAt         DateTime?
  endedAt           DateTime?
  decision          Decision? // mandatory on stop (WP5)
  conclusion        String?
  taintedDays       Json               @default("[]") // ["2026-10-03", …] – manual (ADR-0026), excluded by stats.server (WP4)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  variants          Variant[]
  exposures         Exposure[]
  attributions      OrderAttribution[]
  dailyStats        DailyStat[]
  result            ExperimentResult?

  @@unique([shopId, key])
  @@index([shopId, status])
}

model Variant {
  id           String             @id @default(cuid())
  experimentId String
  experiment   Experiment         @relation(fields: [experimentId], references: [id])
  key          String // "a" | "b" | "c"; "a" is always control
  name         String
  weight       Float // sums to 1.0 per experiment
  isControl    Boolean            @default(false)
  js           String?
  css          String?
  serverConfig Json? // Phase 3
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  exposures    Exposure[]
  attributions OrderAttribution[]

  @@unique([experimentId, key])
}

// Frozen result snapshot (ADR-0025, rahmen §3.2): written once on ENDED (WP5), read only, survives shop/redact.
model ExperimentResult {
  id           String     @id @default(cuid())
  experimentId String     @unique
  experiment   Experiment @relation(fields: [experimentId], references: [id])
  shopId       String
  shop         Shop       @relation(fields: [shopId], references: [id])
  v            Int        @default(1)
  statsVersion String
  frozenAt     DateTime
  snapshot     Json // numbers + frozen context + verdict, no personal data (plan §3)
  createdAt    DateTime   @default(now())
}

// Retention 12 months (ADR-0024) – /jobs/cleanup (WP6). visitorId is always the cookie; customerId links only.
model Exposure {
  id           String     @id @default(cuid())
  shopId       String
  shop         Shop       @relation(fields: [shopId], references: [id])
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id])
  variantId    String
  variant      Variant    @relation(fields: [variantId], references: [id])
  visitorId    String
  customerId   String? // set via login link (4.5), nulled by customers/redact; never a bucketing input
  firstSeenAt  DateTime
  device       String // mobile | desktop | tablet
  country      String?
  referrer     String?
  utm          Json?
  isBot        Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([experimentId, visitorId])
  @@index([experimentId, variantId])
  @@index([experimentId, firstSeenAt])
  // Covers the live aggregation of stats.server.ts (WP4): GROUP BY variant/device/isBot for one experiment, plus the
  // firstSeenAt range that excludes tainted days. Lets Postgres answer it with an index-only scan, which is what keeps
  // it inside the 500 ms budget of ADR-0019 once the table holds every shop's exposures. Index-only scans need the
  // visibility map, so the table has to stay vacuumed – autovacuum does that; after a bulk load, run VACUUM by hand.
  @@index([experimentId, variantId, device, isBot, firstSeenAt])
  @@index([customerId])
  @@index([shopId, firstSeenAt])
}

// Errors the snippet reports via /proxy/err (a variant's JS threw – original was shown, no exposure). Inserts are capped per
// shop and hour in exposures.server.ts; Sentry gets one event per (shop, experiment, message) per 10 min. Retention: WP6.
model SnippetError {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id])
  experimentKey String
  variantKey    String
  message       String
  stack         String?
  url           String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([shopId, createdAt])
}

model Order {
  id              String             @id @default(cuid())
  shopId          String
  shop            Shop               @relation(fields: [shopId], references: [id])
  shopifyOrderId  String
  orderNumber     String // order.name, e.g. "#1001"
  createdAt       DateTime // Shopify created_at (attribution window, 4.8)
  currency        String // shop currency – total_price_set.shop_money.currency_code
  totalPrice      Decimal            @db.Decimal(12, 2) // total_price_set.shop_money.amount
  subtotalPrice   Decimal            @db.Decimal(12, 2)
  totalShipping   Decimal            @db.Decimal(12, 2)
  totalTax        Decimal            @db.Decimal(12, 2)
  totalDiscounts  Decimal            @db.Decimal(12, 2)
  shippingTitle   String? // shipping_lines[0].title
  financialStatus String
  cancelledAt     DateTime?
  customerId      String? // nulled by customers/redact
  sourceName      String // web | shop_app | pos | shopify_draft_order … (4.8)
  isTest          Boolean            @default(false)
  raw             Json // slimOrder() whitelist (rahmen 3.1), never the full payload
  ingestedAt      DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  lineItems       OrderLineItem[]
  attributions    OrderAttribution[]
  refunds         Refund[]

  @@unique([shopId, shopifyOrderId])
  @@index([shopId, createdAt])
  @@index([customerId])
}

model OrderLineItem {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyLineId    String
  shopifyVariantId String?
  shopifyProductId String?
  quantity         Int
  price            Decimal  @db.Decimal(12, 2) // price_set.shop_money.amount (unit price)
  unitCost         Decimal? @db.Decimal(12, 2) // Phase 3
  createdAt        DateTime @default(now())

  @@index([orderId])
}

model OrderAttribution {
  orderId      String
  order        Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  experimentId String
  experiment   Experiment        @relation(fields: [experimentId], references: [id])
  variantId    String
  variant      Variant           @relation(fields: [variantId], references: [id])
  source       AttributionSource
  createdAt    DateTime          @default(now())

  @@id([orderId, experimentId])
  @@index([experimentId, variantId])
  @@index([orderId])
}

model Refund {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyRefundId String   @unique
  amount          Decimal  @db.Decimal(12, 2) // shop currency
  createdAt       DateTime // Shopify created_at
  ingestedAt      DateTime @default(now())

  @@index([orderId])
}

// Materialised by /jobs/daily-stats (WP4) – history only, never the source of the results page.
model DailyStat {
  shopId       String
  shop         Shop       @relation(fields: [shopId], references: [id])
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id])
  variantId    String
  date         DateTime   @db.Date
  visitors     Int
  orders       Int
  revenueGross Decimal    @db.Decimal(14, 2)
  revenueNet   Decimal    @db.Decimal(14, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@id([experimentId, variantId, date])
  @@index([shopId, date])
}

model ReconciliationRun {
  id                String      @id @default(cuid())
  shopId            String
  shop              Shop        @relation(fields: [shopId], references: [id])
  date              DateTime    @db.Date
  ourOrderCount     Int
  shopifyOrderCount Int
  ourRevenue        Decimal     @db.Decimal(14, 2)
  shopifyRevenue    Decimal     @db.Decimal(14, 2)
  status            ReconStatus
  details           Json?
  createdAt         DateTime    @default(now())

  @@index([shopId, date])
}

model AuditLog {
  id           String      @id @default(cuid())
  shopId       String
  shop         Shop        @relation(fields: [shopId], references: [id])
  experimentId String?
  actor        String // e-mail or "shopify:<domain>" / "system"
  action       AuditAction
  diff         Json?
  at           DateTime    @default(now())

  @@index([shopId, at])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id])
  topic       String // normalised Shopify form, e.g. "orders/create" (normalizeTopic)
  shopifyId   String    @unique // X-Shopify-Webhook-Id – idempotency key
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?
  attempts    Int       @default(0) // retry counter for /jobs/retry-webhooks (max 5)
  payload     Json? // only while processing failed (stripPii'd body for the retry) or the customers/data_request export; success: null (ADR-0024)

  @@index([shopId, receivedAt])
  @@index([error])
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  role      UserRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  shops     UserShop[] // only for CLIENT; ADMIN/MEMBER see everything
  tokens    ApiToken[]
}

// Bearer tokens for API and CLI (WP5); only the hash is stored.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  label      String
  expiresAt  DateTime // max 90 days
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model UserShop {
  userId String
  shopId String
  user   User   @relation(fields: [userId], references: [id])
  shop   Shop   @relation(fields: [shopId], references: [id])

  @@id([userId, shopId])
}
